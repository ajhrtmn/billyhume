includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 6
    paths:
        - wp-content/plugins/the-self-hosted-self
        - wp-content/plugins/bh-contest
        - wp-content/plugins/bh-courses
        - wp-content/plugins/bh-crm
        - wp-content/plugins/bh-monetization-woo
        - wp-content/plugins/bh-registry
        - wp-content/plugins/bh-streaming
        - wp-content/plugins/bh-mailpoet
        - wp-content/plugins/bh-tickets
        - wp-content/plugins/bh-video
        - wp-content/plugins/bh-live
        - wp-content/plugins/bh-feedback
        - wp-content/plugins/bh-social
    excludePaths:
        - */vendor/*
        - */tests/*
        # bh-monetization-woo's real-database integration suite (WP_UnitTestCase
        # + the rest of wp-phpunit's own framework, unstubbed here on purpose
        # — this is dev/CI-only test code that runs against a real WP+MySQL
        # instance via @wordpress/env, not a code path this static analysis
        # needs to type-check). Added after a real run surfaced 17 unknown-
        # class/method errors the moment this directory started existing —
        # confirmed, not assumed in advance.
        - */tests-integration/*
        - */bundled/*
        # Query Monitor integration — see the docblock at the top of this
        # file for why (both real classes it extends aren't installed/
        # stubbed anywhere, and no public PHPStan stub package exists for
        # Query Monitor). A whole-file exclude is more honest here than
        # chasing several different error identifiers (constructor/
        # property/method) that all trace back to the same one gap.
        - wp-content/plugins/the-self-hosted-self/includes/class-qm-integration.php
    bootstrapFiles:
        # Dummy values for each plugin's own _URL/_PATH/_VER constants
        # (define()'d via plugin_dir_url()/plugin_dir_path() in each
        # plugin's real main file, which aren't real functions under
        # static analysis) plus a few WP core constants — see the
        # bootstrap file's own docblock. Loading each plugin's REAL main
        # file instead would actually execute it against undefined WP
        # functions and fatal; this hand-written stub avoids that.
        - phpstan-bootstrap.php
    stubFiles:
        # Merges extra @property tags onto the REAL WP_Post class —
        # php-stubs/wordpress-stubs already does exactly this for other
        # dynamic WP_Post properties (its own `@property string
        # $page_template` tag on the same class); this adds the two
        # nav-menu-item properties (title, url) that wp_setup_nav_menu_item()
        # (WP core) bolts onto every WP_Post object wp_get_nav_menu_items()/
        # the `wp_nav_menu_objects` filter hands out — real, honest typing
        # for real dynamic properties, not a suppression. See the stub
        # file's own docblock.
        - phpstan-stubs/wp-post-nav-menu-item.stub.php
    scanFiles:
        # Real WooCommerce stub package (php-stubs/woocommerce-stubs) —
        # eliminates the large "Function wc_get_product not found"/"Class
        # WC_Product_Simple not found" false-positive class that was
        # previously the single biggest source of noise in the-self-hosted-self's
        # and bh-monetization-woo's error counts, now that a real stub
        # exists instead of each WC_* symbol being individually ignored.
        # woocommerce-packages-stubs.php additionally covers WC
        # Subscriptions/Blocks-adjacent classes (e.g. WC_Product_Subscription)
        # this codebase actually references.
        - vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
        - vendor/php-stubs/woocommerce-stubs/woocommerce-packages-stubs.php
        # FPDF — a real, vendored (not composer-installed) library at
        # the-self-hosted-self/vendor/fpdf/fpdf.php, used by bh-courses'
        # certificate-of-completion PDF generation. excludePaths' */vendor/*
        # rule only governs the `paths`/scanDirectories walk, not explicit
        # scanFiles entries, so this is safe to add directly — lets
        # PHPStan actually type-check real FPDF method calls instead of
        # reporting the whole class as unknown.
        - wp-content/plugins/the-self-hosted-self/vendor/fpdf/fpdf.php
        # Timber is a real runtime dependency now, vendored into the core
        # plugin and installed at build time. Listed explicitly rather than
        # via scanDirectories because excludePaths' */vendor/* rule filters
        # the directory walk but NOT explicit scanFiles entries — the same
        # reason FPDF is listed this way directly above.
        - wp-content/plugins/the-self-hosted-self/vendor/timber/timber/src/Timber.php
    scanDirectories:
        - wp-content/plugins/the-self-hosted-self
    # WooCommerce is now stubbed for real (scanFiles above) — bumping to
    # level 6+ later will likely still need an Action Scheduler stub
    # (as_schedule_single_action() etc., used by OUS_Jobs) for full
    # coverage of that one remaining unstubbed dependency.
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # COOKIEPATH/COOKIE_DOMAIN are real WordPress core constants —
        # defined in wp-settings.php at runtime, not in
        # php-stubs/wordpress-stubs (confirmed by grepping the stub
        # package directly: neither constant is declared anywhere in
        # it). PHPStan has no way to know they exist without a real WP
        # bootstrap, which this static analysis deliberately doesn't
        # run. The two real call sites (the-self-hosted-self's class-toast.php,
        # bh-monetization-woo's class-fraud.php) both use them the
        # ordinary way any WP plugin sets a cookie — this was flagged
        # as a known, deliberate exception in earlier PHPStan rounds
        # this session but never actually silenced, which meant a new
        # CI gate (Phase 1 of the ecosystem-wide quality pass) would
        # have failed on a clean checkout with zero real errors to fix.
        -
            message: "#Constant COOKIEPATH not found#"
        -
            message: "#Constant COOKIE_DOMAIN not found#"
        # $wpdb->last_error has no property type declared anywhere in
        # php-stubs/wordpress-stubs (confirmed by grepping the stub file
        # directly) — PHPStan infers its type purely from the first
        # assignment IT sees in whatever file it's analysing (almost
        # always `$wpdb->last_error = '';`, a reset-before-a-query
        # convention used throughout this codebase), not from WP core's
        # real internal behavior (which reassigns it to actual error
        # strings on every query, in files this analysis doesn't scan).
        # Ecosystem-wide, not file-scoped, since this exact
        # reset-then-check-!==''-after-a-raw-query pattern recurs across
        # multiple plugins, not just the one it happened to surface in
        # first.
        -
            message: "#Strict comparison using !== between '' and '' will always evaluate to false#"
        # Same $wpdb->last_error stub gap as above, the plain-truthy-check
        # variant (`if ($wpdb->last_error)` rather than `!== ''`) — scoped
        # to this one file/line rather than the generic "If condition is
        # always false" message ecosystem-wide, since that phrasing is
        # common enough to risk masking a genuinely different dead-code
        # bug elsewhere.
        -
            message: '#If condition is always false#'
            path: wp-content/plugins/bh-social/includes/class-activator.php
        # add_option()'s 4th arg ($autoload) — the stub types this
        # strictly as bool|null, but WP core's real implementation
        # (wp_determine_option_autoload_value(), wp-includes/option.php)
        # explicitly handles the legacy 'yes'/'no' string convention too
        # — confirmed by reading that function's real source directly,
        # not assumed. Passing 'no' is genuine, correct, WP-native
        # behavior, just stricter-typed in the stub than reality.
        -
            message: '#Parameter \#4 \$autoload of function add_option expects bool\|null, string given#'
            path: wp-content/plugins/bh-contest/includes/class-api.php
        # BH_VOTE_BASE is define()'d as the literal int 1
        # (bh-contest.php) — PHPStan can correctly prove the "add an s"
        # pluralization branch here is unreachable AS THE CONSTANT IS
        # TODAY, but the ternary is deliberately forward-looking (correct
        # grammar if that constant is ever changed to anything else) —
        # not dead code worth removing, since removing it would silently
        # break pluralization the moment BH_VOTE_BASE ever changes.
        -
            message: '#Else branch is unreachable because ternary operator condition is always true#'
            path: wp-content/plugins/bh-contest/includes/class-contest-wizard.php
        # Same well-known PHPStan by-reference-mutation limitation as the
        # the-self-hosted-self rules further down this file, this time via
        # ReflectionMethod::invokeArgs(null, [&$tree]) rather than a
        # WordPress hook — PHPStan sees $tree's pre-call type (all blank
        # '' uids in the test fixture) and never tracks the mutation the
        # reflected private method actually performs, making the later
        # real assertions (checking the blanks WERE backfilled) look like
        # dead/always-false code. The test logic itself is correct.
        -
            message: '#(Result of && is always false|will always evaluate to false)#'
            path: wp-content/plugins/bh-crm/includes/class-test-suite.php
        # bh-mailpoet's class-sync.php calls MailPoet's own API
        # (MailPoet\API\MP\v1\API) behind class_exists('\MailPoet\API\API')
        # guards at every call site — a real, correct optional-dependency
        # pattern, not a bug. MailPoet itself isn't installed in this
        # analysis environment (same reasoning already applied to the
        # WC_Log_Handler_Interface/BHL_*/Advanced_Media_Offloader unknown-
        # class noise elsewhere in this config), so PHPStan can't resolve
        # the class at all. Scoped to that one namespace, not a blanket
        # "ignore unknown classes" rule.
        -
            message: '#(MailPoet\\|Call to method \w+\(\) on an unknown class MailPoet\\)#'
            path: wp-content/plugins/bh-mailpoet/includes/class-sync.php
        # class-media-wizard.php's bh-live integration (BHL_EngineRegistry,
        # BHL_OwncastEngine, BHL_CloudflareStreamEngine, BHL_FlyProvisioner,
        # BHL_WorkersChat) and Advanced Media Offloader integration are both
        # real, correct optional-dependency patterns — every call site is
        # guarded by class_exists() at call time (this ecosystem's own
        # standing convention, see CLAUDE.md). Neither bh-live nor Advanced
        # Media Offloader is in phpstan.neon's scanned `paths` (bh-live
        # isn't part of this repo's own plugin set the way bh-contest/
        # bh-crm/etc. are, and Advanced Media Offloader is a genuine
        # third-party WordPress.org plugin, not authored here), so PHPStan
        # can't resolve either — same class of noise as the MailPoet rule
        # above, not real bugs.
        -
            message: '#(unknown class BHL_\w+|BHL_\w+ not found|Advanced_Media_Offloader)#'
            path: wp-content/plugins/the-self-hosted-self/includes/class-media-wizard.php
        # WC_Product_Subscription is a WooCommerce Subscriptions class (a
        # separate paid extension, not core WooCommerce) — this code path
        # only reaches this branch after a WC_Subscriptions-active check
        # elsewhere in the same method. php-stubs/woocommerce-stubs only
        # covers WooCommerce core, not the Subscriptions extension.
        # Path updated for the provider-registry refactor: this logic
        # moved from class-commerce.php into BH_WooCommerceProvider
        # (class-commerce-provider-woocommerce.php), a pure move.
        -
            message: '#WC_Product_Subscription#'
            path: wp-content/plugins/the-self-hosted-self/includes/class-commerce-provider-woocommerce.php
        -
            message: '#WC_Product_Subscription#'
            path: wp-content/plugins/bh-monetization-woo/includes/class-product-sync.php
        # register_block_type()'s 'api_version' arg — WordPress core's OWN
        # docblock types this as `string` (confirmed: php-stubs/wordpress-
        # stubs just reproduces that docblock verbatim), but the real
        # property default (WP_Block_Type::$api_version = 1) and every
        # real-world usage — every block.json's "apiVersion" field, every
        # core Gutenberg block registration — is a bare integer (1, 2, 3).
        # This is a known inaccuracy in WP core's own docs, not a bug
        # here; passing a string would be the actually-wrong choice.
        -
            message: '#api_version#'
            path: wp-content/plugins/bh-monetization-woo/includes/class-storefront.php
        # A well-documented PHPStan limitation, not a real bug: a variable
        # captured by-reference into a closure (use (&$var)) and mutated
        # only when WordPress's hook system later CALLS that closure
        # indirectly (add_filter()/do_action()) is invisible to PHPStan's
        # flow analysis — it sees the variable's state at the point the
        # closure was DEFINED, never the mutation from the later indirect
        # call, and reports the pre-mutation state as though it were
        # permanent. Confirmed in both files below by tracing the actual
        # closure wiring before ignoring: class-codebase-docs.php's
        # $flush_paragraph is called repeatedly across a real loop that
        # populates $paragraph first (line 177); class-core-test-suite.php's
        # $captured is set by a closure registered via
        # add_filter('pre_wp_mail', ...) and only read after the
        # BH_Mail::send() call that triggers it.
        -
            message: '#(Negated boolean expression is always true|Unreachable statement)#'
            path: wp-content/plugins/the-self-hosted-self/includes/class-codebase-docs.php
        -
            message: '#(Offset .(to|headers). on null on left side of \?\? does not exist|will always evaluate to false)#'
            path: wp-content/plugins/the-self-hosted-self/includes/class-core-test-suite.php
        # add_submenu_page(null, ...) — a deliberate, documented pattern
        # (CLAUDE.md's own "New dev/admin-only pages" section, and each
        # call site's own surrounding comment): registering a hidden page
        # with NO parent at all, specifically to sidestep a real,
        # previously-hit WordPress page-hook-resolution bug this install
        # documented after multiple sessions of debugging. WP core's own
        # add_submenu_page() docblock types $parent_slug as plain string
        # (not ?string), but the real function body has no type
        # declaration to actually enforce that — null is accepted at
        # runtime. Not changing working, deliberately-chosen behavior on
        # a docblock-only type mismatch without the ability to verify a
        # change against a live install.
        -
            message: '#Parameter \#1 \$parent_slug of function add_submenu_page expects string, null given#'
            paths:
                - wp-content/plugins/the-self-hosted-self/includes/class-studio.php
                - wp-content/plugins/the-self-hosted-self/includes/class-style-gallery.php
        # BH_Element_Prefab was deleted along with ~6,700 lines of the
        # custom page-builder (see CLAUDE.md's "page-builder saga" and
        # this exact file's own line-45 comment: "BH_Element_Prefab
        # doesn't currently exist, but this stays correct") — every call
        # site is already behind class_exists('BH_Element_Prefab'), a
        # deliberately-preserved optional-integration seam for if that
        # class is ever reintroduced, not a broken reference.
        -
            message: '#unknown class BH_Element_Prefab#'
            path: wp-content/plugins/the-self-hosted-self/includes/class-gutenberg-block.php
