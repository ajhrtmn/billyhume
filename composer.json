{
    "name": "own-ur-shit/dev-tooling",
    "description": "Dev-only tooling for running this repo's pure-logic PHPUnit suites (wp-content/plugins/*/tests/) and static analysis (phpstan.neon). Not a runtime dependency of any plugin \u2014 WordPress itself is loaded from wp-load.php, never Composer's autoloader.",
    "require-dev": {
        "phpunit/phpunit": "^9",
        "phpstan/phpstan": "^1.11",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "php-stubs/woocommerce-stubs": "^11.0",
        "shipmonk/dead-code-detector": "^0.5.1",
        "squizlabs/php_codesniffer": "^3.13",
        "wp-coding-standards/wpcs": "^3.4",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2"
    },
    "config": {
        "platform": {
            "php": "8.2"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "phpstan": "phpstan analyse --memory-limit=2G",
        "test": [
            "phpunit -c wp-content/plugins/own-ur-shit/tests/phpunit.xml",
            "phpunit -c wp-content/plugins/bh-courses/tests/phpunit.xml",
            "php tools/check-render-parity.php"
        ],
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "phpcs:changed": "bash tools/phpcs-changed.sh",
        "check:render-parity": "php tools/check-render-parity.php"
    }
}
