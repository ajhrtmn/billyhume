{
  "compilerOptions": {
    "target": "ES2019",
    "lib": [
      "ES2019",
      "DOM"
    ],
    "module": "none",
    "rootDir": "assets/ts",
    "outDir": "assets/js",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "removeComments": false,
    "newLine": "lf"
  },
  "include": [
    "assets/ts/**/*.ts"
  ],
  "exclude": [
    "assets/ts/components/**/*"
  ]
}
