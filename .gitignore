# Wordpress - ignore core, configuration, examples, uploads and logs.
# https://github.com/github/gitignore/blob/main/WordPress.gitignore

# Configuration
wp-config.php

# Example themes
/wp-content/themes/twenty*/

# Example plugin
/wp-content/plugins/hello.php

# Uploads
/wp-content/uploads/

# Log files
*.log

# htaccess
/.htaccess

# /vendor/ is dev-only Composer tooling (PHPUnit for wp-content/plugins/*/tests/)
# — not committed, same as node_modules. Never deployed to the live FTP site
# (see run-all-tests.sh's own docblock) — that site only ever runs
# OUS_TestRunner via Debug Tools, and the stable->FTP GitHub Action never
# touches composer files at all.
#
# composer.lock WAS also gitignored here for the same reasoning, but that
# broke every Wasmer preview deploy (dev/master) for 12+ days: Wasmer's own
# build step unconditionally runs `composer install` against a committed
# composer.lock as part of packaging ANY WordPress site, regardless of
# whether the app needs PHPUnit at runtime — with no composer.lock in the
# repo, the build fails outright ("/composer.lock": not found) before the
# site ever deploys. vendor/ itself still doesn't need to be committed since
# Wasmer's own `composer install` regenerates it during the build.
/vendor/
wp-content/plugins/*/tests/.phpunit.result.cache

# node_modules/ is dev-only tooling too (TypeScript compiler for the
# assets/ts/ pilot — see package.json), same posture as /vendor/ above:
# never deployed, regenerated locally via `npm install`. package-lock.json
# IS committed (same reasoning as composer.lock: Wasmer's build step may
# run `npm install` against a committed lockfile).
/node_modules/

# macOS Finder metadata — never something a WordPress install needs
# tracked, in any directory
.DS_Store

# WordPress drop-ins (wp-content/*.php custom-class overrides, e.g.
# db.php). These are commonly installed by a debug plugin (Query
# Monitor's DB profiling, in this case) as a symlink to an ABSOLUTE
# LOCAL PATH — that symlink got committed by accident once (see git
# history) and broke the Wasmer/Shipit deploy build, since the target
# path only exists on the machine that created it and points into
# wp-content/plugins/query-monitor/, which isn't even tracked by this
# .gitignore's own plugin whitelist below. Never commit these.
/wp-content/db.php
/wp-content/object-cache.php
/wp-content/advanced-cache.php

# Third-party plugins: ignore everything under wp-content/plugins EXCEPT
# the eleven Own Ur Shit ecosystem plugins (own-ur-shit + peers), the
# self-hosted-self-admin-skin wp-admin reskin (a standalone plugin, but
# still part of this ecosystem's own tracked code — depends only on
# core, same as every peer plugin), and the ecosystem's own root-level
# docs. Anything else installed later (a new WooCommerce extension, a
# one-off diagnostic tool like Query Monitor, etc.) is ignored by
# default without needing a new line added here — only this
# ecosystem's own plugins need to be explicitly whitelisted.
/wp-content/plugins/*
!/wp-content/plugins/own-ur-shit/
!/wp-content/plugins/bh-contest/
!/wp-content/plugins/bh-courses/
!/wp-content/plugins/bh-crm/
!/wp-content/plugins/bh-feedback/
!/wp-content/plugins/bh-monetization-woo/
!/wp-content/plugins/bh-registry/
!/wp-content/plugins/bh-streaming/
!/wp-content/plugins/bh-video/
!/wp-content/plugins/bh-live/
!/wp-content/plugins/bh-social/
!/wp-content/plugins/bh-mailpoet/
!/wp-content/plugins/bh-tickets/
!/wp-content/plugins/self-hosted-self-admin-skin/
!/wp-content/plugins/*.md
!/wp-content/plugins/LICENSE
!/wp-content/plugins/index.php

# All themes
#
# Note: If you wish to whitelist themes,
# uncomment the next line
#/wp-content/themes

# AI Dev Run workflow (.github/workflows/ai-run.yml) runtime artifacts —
# TASK_SPEC.md and every *.log are generated fresh each run and uploaded
# as a workflow artifact already; committing them would just accumulate
# noise across every mobile-triggered run.
/.ai_workflow/*
!/.ai_workflow/.gitkeep

# Playwright UX-audit artifacts (tests/ux/) — traces, HTML reports, and the
# stored admin session. The session file contains real auth cookies and must
# never be committed; everything else is regenerated by `npm run audit:ux`.
/test-results/
/tests/ux/report/
/tests/ux/.auth/
/playwright-report/
/blob-report/

# Storybook: the static build output, and the fixtures/CSS generated from PHP
# by tools/gen-storybook-fixtures.php. Both are regenerated by
# `npm run storybook` — committing them would create a second copy of markup
# free to drift from the renderers, which is the exact thing this setup avoids.
/storybook-static/
/.storybook/fixtures.json
/.storybook/design-system.css
