{
  "name": "the-self-hosted-self-dev-tooling",
  "private": true,
  "description": "Dev-only tooling for this repo: TypeScript sources (wp-content/plugins/*/assets/ts/), CSS linting, unit tests, and browser-driven UX audits. Not a runtime dependency \u2014 plugins ship pre-compiled .js and plain .css, and the FTP deploy syncs plugin folders verbatim with no build step. node_modules/ is gitignored.",
  "scripts": {
    "build:the-self-hosted-self": "tsc -p wp-content/plugins/the-self-hosted-self/tsconfig.json",
    "watch:the-self-hosted-self": "tsc -p wp-content/plugins/the-self-hosted-self/tsconfig.json --watch",
    "build:bh-contest": "tsc -p wp-content/plugins/bh-contest/tsconfig.json",
    "watch:bh-contest": "tsc -p wp-content/plugins/bh-contest/tsconfig.json --watch",
    "build:bh-crm": "tsc -p wp-content/plugins/bh-crm/tsconfig.json",
    "watch:bh-crm": "tsc -p wp-content/plugins/bh-crm/tsconfig.json --watch",
    "build:bh-streaming": "tsc -p wp-content/plugins/bh-streaming/tsconfig.json",
    "watch:bh-streaming": "tsc -p wp-content/plugins/bh-streaming/tsconfig.json --watch",
    "build:bh-courses": "tsc -p wp-content/plugins/bh-courses/tsconfig.json",
    "watch:bh-courses": "tsc -p wp-content/plugins/bh-courses/tsconfig.json --watch",
    "lint:css": "stylelint \"wp-content/plugins/{the-self-hosted-self,bh-*,self-hosted-self-admin-skin}/assets/css/*.css\"",
    "lint:css:fix": "npm run lint:css -- --fix",
    "format:css": "node tools/expand-css.js wp-content/plugins/{the-self-hosted-self,bh-*,self-hosted-self-admin-skin}/assets/css/*.css",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "audit:ux": "playwright test",
    "audit:ux:ui": "playwright test --ui",
    "build:all": "npm run build:the-self-hosted-self && npm run build:bh-contest && npm run build:bh-crm && npm run build:bh-streaming && npm run build:bh-courses && npm run build:components",
    "check": "npm run build:all && npm run lint:css && npm run test:unit",
    "storybook:fixtures": "php tools/gen-storybook-fixtures.php",
    "storybook": "npm run storybook:fixtures && storybook dev -p 6006 --no-open",
    "storybook:build": "npm run storybook:fixtures && storybook build -o storybook-static",
    "build:components": "npm run typecheck:components && esbuild wp-content/plugins/the-self-hosted-self/assets/ts/components/index.ts --bundle --format=esm --target=es2022 --minify --outfile=wp-content/plugins/the-self-hosted-self/assets/js/components/bhy-components.js",
    "typecheck:components": "tsc -p wp-content/plugins/the-self-hosted-self/tsconfig.components.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/html-vite": "^10.5.10",
    "lit": "^3.3.3",
    "storybook": "^10.5.10",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.6.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
